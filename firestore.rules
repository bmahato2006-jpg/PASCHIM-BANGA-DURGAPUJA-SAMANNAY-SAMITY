rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: votes_log
    // Document ID: {voteId} (e.g., {user_uid}_{pandal_id})
    // Fields:
    //   - id: string (optional, max 200 chars) - Vote document ID
    //   - user_uid: string (required, max 128 chars) - Voter Firebase UID
    //   - pandal_id: string (optional, max 100 chars) - Pandal document ID
    //   - category: string (optional, max 50 chars) - Specific voting category
    //   - timestamp: timestamp (optional) - Time vote was registered
    //
    // Collection: pandals
    // Document ID: {pandalId} (e.g., slug or unique key)
    // Fields:
    //   - id: string (optional, max 100 chars) - Pandal identifier
    //   - name: string (optional, max 150 chars) - Pandal display name
    //   - clubName: string (optional, max 150 chars) - Pandal club name
    //   - ward: string (optional, max 100 chars) - Ward number / area
    //   - theme: string (optional, max 300 chars) - Pandal art theme
    //   - total_votes: int (required, >= 0) - Aggregated vote counter
    //   - votes: map (optional) - Map of category vote counters
    //   - server_created_at: timestamp (optional) - Server timestamp
    //   - updated_at: timestamp (optional) - Server timestamp
    //
    // Collection: committees
    // Document ID: {committeeId} (e.g., normalized club slug)
    // Fields:
    //   - user_id: string (required, max 128 chars) - Committee owner UID
    //   - committee_name: string (required, max 150 chars) - Committee name
    //   - slug: string (optional, max 150 chars) - Unique URL slug
    //   - ward: string (optional, max 100 chars) - Ward or locality
    //   - secretary_name: string (optional, max 100 chars) - Secretary contact name
    //   - contact_number: string (optional, max 30 chars) - Contact phone number
    //   - email: string (optional, max 100 chars) - Contact email address
    //   - theme: string (optional, max 300 chars) - Pandal theme summary
    //   - budget: string (optional, max 100 chars) - Budget details
    //   - logo_url: string (optional, max 500 chars) - Club logo or banner URL
    //   - total_votes: int (optional) - Total votes
    //   - created_at: string (optional) - ISO creation timestamp
    //   - updated_at: string (optional) - ISO update timestamp
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated (supports both standard and anonymous auth)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns the resource by matching user ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Domain validator for votes_log collection
    function isValidVoteLog(data) {
      return data.user_uid is string &&
             data.user_uid.size() > 0 &&
             data.user_uid.size() <= 128 &&
             (!('pandal_id' in data) || (data.pandal_id is string && data.pandal_id.size() <= 100)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
             (!('id' in data) || (data.id is string && data.id.size() <= 200));
    }

    // Domain validator for committees collection
    function isValidCommittee(data) {
      return data.user_id is string &&
             data.user_id.size() > 0 &&
             data.user_id.size() <= 128 &&
             data.committee_name is string &&
             data.committee_name.size() > 0 &&
             data.committee_name.size() <= 150 &&
             (!('slug' in data) || (data.slug is string && data.slug.size() <= 150)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 100)) &&
             (!('contact_number' in data) || (data.contact_number is string && data.contact_number.size() <= 30)) &&
             (!('ward' in data) || (data.ward is string && data.ward.size() <= 100)) &&
             (!('secretary_name' in data) || (data.secretary_name is string && data.secretary_name.size() <= 100)) &&
             (!('theme' in data) || (data.theme is string && data.theme.size() <= 300)) &&
             (!('budget' in data) || (data.budget is string && data.budget.size() <= 100)) &&
             (!('logo_url' in data) || (data.logo_url is string && data.logo_url.size() <= 500));
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Collection: votes_log
    // Audit log of individual votes cast by voters
    match /votes_log/{voteId} {
      // Prohibit list reads to protect voter privacy and prevent mass scraping
      allow list: if false;

      // Only the voter who cast the vote can read their own vote record
      allow get: if isAuthenticated() && request.auth.uid == resource.data.user_uid;

      // Creation allowed only for authenticated voters matching user_uid,
      // and only if the document does not already exist
      allow create: if isAuthenticated() &&
                      request.auth.uid == request.resource.data.user_uid &&
                      (resource == null || !exists(/databases/$(database)/documents/votes_log/$(voteId))) &&
                      isValidVoteLog(request.resource.data);

      // Updates and deletes are strictly prohibited (immutable vote records)
      allow update, delete: if false;
    }

    // Collection: pandals
    // Pandal profiles and live leaderboard tallies
    match /pandals/{pandalId} {
      // Publicly readable by anyone for discovery and leaderboard rankings
      allow read: if true;

      // Creation allowed by organizers or if document does not exist yet
      allow create: if isAuthenticated() ||
                      resource == null ||
                      !exists(/databases/$(database)/documents/pandals/$(pandalId));

      // Updates strictly allow total_votes to be incremented by exactly 1
      allow update: if request.resource.data.total_votes == resource.data.total_votes + 1;

      // Deletes are strictly disallowed
      allow delete: if false;
    }

    // Collection: committees
    // Official Durga Puja Committee listings and organizers
    match /committees/{committeeId} {
      // Publicly readable for visitor discovery
      allow read: if true;

      // Only the authenticated committee owner can create their committee record
      allow create: if isAuthenticated() &&
                      request.auth.uid == request.resource.data.user_id &&
                      isValidCommittee(request.resource.data);

      // Only the authenticated committee owner can update their committee record
      // Ownership field (user_id) is immutable
      allow update: if isAuthenticated() &&
                      request.auth.uid == request.resource.data.user_id &&
                      request.resource.data.user_id == resource.data.user_id &&
                      isValidCommittee(request.resource.data);

      // Deletes are strictly disallowed
      allow delete: if false;
    }

    // ===============================================================
    // Catch-All Default Deny
    // ===============================================================
    // Any unmatched paths default to deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
