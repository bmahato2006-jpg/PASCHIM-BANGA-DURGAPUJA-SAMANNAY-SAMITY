rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Paschim Banga DurgaPuja Samannay Samity
    // High-Scale Production Firestore Security Rules
    // Engineered for Anonymous & Authenticated Voter Protection
    // ===============================================================

    // Helper: Check if user is authenticated (standard or anonymous)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Verify voter ownership matching their Firebase UID
    function isVoter(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ===============================================================
    // 1. votes_log Collection
    // ===============================================================
    // Documents:
    // - Primary ballot: {user_uid}_{pandal_id}
    // - Category token lock: {user_uid}_cat_{category}
    //
    // Security Guarantees:
    // - Completely prevents double-voting by requiring doc to be new
    // - Enforces voter UID binding: request.auth.uid == user_uid
    // - Blocks collection listing to prevent mass voter scraping
    // - Completely immutable: update and delete are strictly denied
    match /votes_log/{voteId} {
      // Prohibit list queries to safeguard voter privacy
      allow list: if false;

      // Only the individual voter can inspect their own cast ballot
      allow get: if isVoter(resource.data.user_uid);

      // Create ballot document:
      // Must be authenticated, UID must match, and document must NOT already exist
      allow create: if isAuthenticated() &&
                      request.auth.uid == request.resource.data.user_uid &&
                      !exists(/databases/$(database)/documents/votes_log/$(voteId)) &&
                      request.resource.data.user_uid is string &&
                      request.resource.data.user_uid.size() > 0 &&
                      (!('pandal_id' in request.resource.data) || request.resource.data.pandal_id is string) &&
                      (!('category' in request.resource.data) || request.resource.data.category is string);

      // Ballots cannot be modified or retracted once cast
      allow update, delete: if false;
    }

    // ===============================================================
    // 2. pandals Collection
    // ===============================================================
    // Pandal profiles and live leaderboard counters
    //
    // Fields:
    // - total_votes: integer counter
    // - votes: map containing category votes (e.g. idol, theme, lighting, eco)
    // - updated_at: server timestamp
    match /pandals/{pandalId} {
      // Publicly readable by everyone (voters, guests, leaderboard ranking)
      allow read: if true;

      // Creation allowed by authenticated users or initial seeding
      allow create: if isAuthenticated() ||
                      resource == null ||
                      !exists(/databases/$(database)/documents/pandals/$(pandalId));

      // Updates strictly enforce atomic increment by exactly 1 on total_votes
      // Handles both existing pandals and documents with initial total_votes = 0
      allow update: if (
        request.resource.data.total_votes == resource.data.get('total_votes', 0) + 1
      );

      // Super Admin can delete pandals
      allow delete: if isAuthenticated() && request.auth.token.email == 'admin111205@gmail.com';
    }

    // ===============================================================
    // 3. committees Collection
    // ===============================================================
    // Registered Durga Puja Committees & Club Organizers
    match /committees/{committeeId} {
      // Publicly readable for visitor pandal exploration
      allow read: if true;

      // Only authenticated organizer matching user_id can create or update
      allow create: if isAuthenticated() &&
                      request.auth.uid == request.resource.data.user_id &&
                      request.resource.data.user_id is string &&
                      request.resource.data.committee_name is string;

      // Organizer or Super Admin (admin111205@gmail.com) can update committees
      allow update: if isAuthenticated() && (
                      (request.auth.uid == resource.data.user_id && request.resource.data.user_id == resource.data.user_id) ||
                      request.auth.token.email == 'admin111205@gmail.com'
                    );

      // Super Admin can delete committees
      allow delete: if isAuthenticated() && request.auth.token.email == 'admin111205@gmail.com';
    }

    // ===============================================================
    // 4. Default Catch-All Deny
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
